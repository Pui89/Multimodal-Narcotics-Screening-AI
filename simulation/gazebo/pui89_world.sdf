<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="pui89_screening_indoor_corridor_starter">
    <physics name="pui89_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
