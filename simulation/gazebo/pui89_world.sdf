<model name="right_wall"><static>true</static><pose>0 -2 1.5 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>16 0.2 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>16 0.2 3</size></box></geometry><material><diffuse>0.76 0.79 0.81 1</diffuse></material></visual></link></model>
<model name="screening_table"><static>true</static><pose>2 0 0.7 0 0 0</pose><link name="table"><collision name="collision"><geometry><box><size>1.3 1.5 1.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.3 1.5 1.4</size></box></geometry><material><diffuse>0.23 0.35 0.46 1</diffuse></material></visual></link></model>
<model name="generic_test_box"><static>true</static><pose>-3 0 0.3 0 0 0.2</pose><link name="box"><collision name="collision"><geometry><box><size>0.6 0.5 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 0.5 0.6</size></box></geometry><material><diffuse>0.65 0.48 0.24 1</diffuse></material></visual></link></model>
